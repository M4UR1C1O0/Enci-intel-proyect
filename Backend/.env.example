GEMINI_API_KEY=your_gemini_api_key_here
CHAT_AUTH_REQUIRED=true
ADMIN_AUTH_REQUIRED=true
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Bucket GCS para persistir el vector store y los PDFs en Cloud Run.
# Si no se define, se usa el disco local (desarrollo).
# GCS_BUCKET_NAME=enci-intel-rag

# --- FALLBACK GROQ (sin cuota de embeddings, ideal para desarrollo local) ---
# Groq tiene prioridad sobre Gemini si GROQ_API_KEY está activo.
# Al cambiar de proveedor, elimina Backend/data/vector_store.pkl y reinicia.
# GROQ_API_KEY=your_groq_api_key_here
