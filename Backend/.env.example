# =============================================
# Enci-Intel Backend — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env real al repositorio
# =============================================

# Google Cloud Platform
GCP_PROJECT_ID=enci-intel-b48da
GCP_LOCATION=us-central1

# Vertex AI / Gemini
GEMINI_MODEL=gemini-1.5-pro

# Firebase / Firestore
FIREBASE_PROJECT_ID=enci-intel-b48da

# Ruta al service account JSON (solo en local)
# En Cloud Run NO se necesita — usa Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\tu\service-account.json
